# Perfiles que Docker Compose activa sin escribir --profile en cada comando
# (core = app; datos = Mongo + lake + ETL; agrega ,escala para Citus)
COMPOSE_PROFILES=core,datos

# =============================================================
# Copia este archivo a .env y cambia TODOS los valores "cambia-esto".
# El archivo .env NUNCA se sube al repositorio.
# =============================================================

# --- General ---
# desarrollo | produccion  (en produccion la API no arranca con la SECRET_KEY de ejemplo)
APP_ENV=desarrollo
TZ=America/Bogota
# Firma las sesiones. Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto
# La cookie de sesión solo viaja por HTTPS (Tailscale Funnel); localhost también cuenta como seguro
COOKIE_SEGURA=true

# --- PostgreSQL (fuente de verdad) ---
POSTGRES_DB=objetos_perdidos
POSTGRES_USER=app
POSTGRES_PASSWORD=cambia-esto
DATABASE_URL=postgresql://app:cambia-esto@postgres:5432/objetos_perdidos

# --- Redis (caché y colas) ---
REDIS_URL=redis://redis:6379/0

# --- MongoDB (perfil datos) ---
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=cambia-esto
MONGO_URL=mongodb://root:cambia-esto@mongo:27017/?authSource=admin
MONGO_DB=objetos_perdidos

# --- Data Lake S3 compatible: SeaweedFS (perfil datos) ---
S3_ENDPOINT=http://lake:8333
S3_ACCESS_KEY=lake-admin
S3_SECRET_KEY=cambia-esto-con-una-clave-larga
S3_BUCKET=lake

# --- ETL y analítica (servicio etl, perfil datos) ---
ETL_TRANSFORMAR_MINUTOS=15
ETL_COPIAR_MONGO=true
ETL_LOTE=5000
DUCKDB_MEMORIA=2GB

# --- Agente analista (corre dentro del worker de agentes; lee gold del lake) ---
# Cada cuántas horas escribe informes (0 = apagado)
ANALISTA_HORAS=6
# false = resumen con plantilla fija, sin LLM
ANALISTA_LLM=true

# --- Citus (perfil escala) ---
CITUS_PASSWORD=cambia-esto

# --- IA: proveedor de chat (cualquier API compatible con OpenAI) ---
# ollama (local, por defecto) | deepseek | qwen
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b
# Ejemplos de proveedores cloud (requieren saldo o cuota):
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat

# --- IA: proveedor de embeddings (separado del chat; ver ADR-005) ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# --- Agentes (ADR-014) ---
# llm = normaliza con el LLM | heuristica = sin LLM (respaldo; ver ADR-013)
MATCHER_NORMALIZADOR=llm
MATCHER_EXPLICAR=true
AGENTES_INTERVALO=2

# --- Correo ---
# Desarrollo: Mailpit atrapa todo (http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_FROM=Objetos Perdidos UNIMINUTO <no-reply@objetos-perdidos.local>
# Dirección con la que se arman los enlaces de los correos (restablecer contraseña).
# En producción: la URL de Tailscale Funnel, p. ej. https://portatil.tu-tailnet.ts.net
URL_PUBLICA=http://localhost:8080
# Producción (Gmail con contraseña de aplicación):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=cuenta-del-grupo@gmail.com
# SMTP_PASSWORD=contraseña-de-aplicacion
# SMTP_TLS=true

# --- Reglas de negocio ---
DIAS_CUSTODIA=90
