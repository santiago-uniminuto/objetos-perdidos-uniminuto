# Caddy recibe el tráfico de Tailscale Funnel (que ya pone HTTPS)
# y lo reparte: /api -> FastAPI, el resto -> frontend estático (ADR-017).

{
	servers {
		# IP real del visitante (ADR-009). Funnel pone en X-Forwarded-For la IP pública del visitante y llega a
		# Caddy desde la red interna de Docker. Sin esto, Caddy descarta ese encabezado (por seguridad) y todos
		# los visitantes se verían como una sola IP: el límite de 60/min del portal sería compartido y la
		# auditoría no serviría. Confiar en rangos privados es seguro: Caddy solo escucha en 127.0.0.1.
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Funnel solo sirve HTTPS: el navegador no vuelve a intentar http (en http://localhost se ignora)
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv/web
		# Política de contenido solo para la web (Swagger en /api/docs carga recursos externos).
		# 'unsafe-inline' en scripts lo exige el export estático de Next.js (datos de hidratación en línea).
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		# Los archivos con hash en el nombre no cambian nunca; las páginas siempre se revalidan
		@inmutables path /_next/static/*
		header @inmutables Cache-Control "public, max-age=31536000, immutable"
		header @paginas Cache-Control "no-cache"
		@paginas not path /_next/static/*
		try_files {path} {path}/index.html {path}.html
		file_server
	}

	# Página 404 del frontend cuando un archivo no existe (los errores de la API pasan tal cual)
	handle_errors 404 {
		root * /srv/web
		rewrite * /404.html
		file_server
	}
}
